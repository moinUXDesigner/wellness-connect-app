APP_NAME=WellnessConnect
APP_ENV=local
APP_KEY=
# Generate with: php artisan key:generate
APP_DEBUG=false
APP_URL=http://localhost:8080

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost,https://localhost,capacitor://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=wellness_connect
DB_USERNAME=wellness_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Set SESSION_ENCRYPT=true in all environments to store session payloads encrypted in the database.
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Use 'log' for local dev only. Set to 'smtp', 'postmark', or 'resend' in production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@wellnessconnect.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MEMBERSHIP_RECEIPT_PREFIX=AWC-R
REFUND_APPROVAL_THRESHOLD_MINOR=1000000
FREE_CANCELLATION_BEFORE_HOURS=24

# Required for trainer registration's "Continue with Google" option.
GOOGLE_CLIENT_ID=

# Token expiry in minutes (10080 = 7 days). Increase for mobile apps, decrease for high-security contexts.
SANCTUM_TOKEN_EXPIRY_MINUTES=10080

# Dev-only OTP dummy codes. Ignored in production (APP_ENV=production always uses random codes).
# For mobile OTP: set TRAINER_OTP_DUMMY_CODE to the code your DummySmsVerificationSender returns.
TRAINER_OTP_DUMMY_CODE=123456
# For email OTP: set TRAINER_EMAIL_OTP_DUMMY_CODE and ensure MAIL_MAILER=log so the code appears in logs.
TRAINER_EMAIL_OTP_DUMMY_CODE=123456
TRAINER_EMAIL_OTP_EXPIRY_MINUTES=10
TRAINER_EMAIL_OTP_RESEND_SECONDS=60
TRAINER_EMAIL_OTP_MAX_ATTEMPTS=5
